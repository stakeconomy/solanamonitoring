[
  {
    "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
    },
    "description": "1 means the selected validator and at least one current reference produced comparable inferred counts in the latest attributable interval. 0 means collecting or unattributed; it is not a performance failure.",
    "fieldConfig": {
      "defaults": {
        "color": {
          "mode": "thresholds"
        },
        "decimals": 2,
        "mappings": [
          {
            "type": "value",
            "options": {
              "0": {
                "color": "orange",
                "text": "Collecting / unattributed"
              },
              "1": {
                "color": "green",
                "text": "Comparable interval"
              }
            }
          }
        ],
        "noValue": "No recent data",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {
              "color": "orange",
              "value": null
            },
            {
              "color": "green",
              "value": 1
            }
          ]
        },
        "unit": "none"
      },
      "overrides": []
    },
    "gridPos": {
      "h": 3,
      "w": 6,
      "x": 0,
      "y": 55
    },
    "id": 168,
    "interval": "1m",
    "options": {
      "colorMode": "value",
      "graphMode": "none",
      "justifyMode": "auto",
      "orientation": "horizontal",
      "reduceOptions": {
        "calcs": [
          "lastNotNull"
        ],
        "fields": "",
        "values": false
      },
      "textMode": "auto"
    },
    "pluginVersion": "9.2.3",
    "targets": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "editorMode": "code",
        "expr": "last_over_time(nodemonitor_alpenglowObservedReady{cluster=~\"$cluster\",genesis=~\"$genesis\",consensus=\"alpenglow\",pubkey=\"$pubkey\",vote_account=~\"$vote_account\"}[5m])",
        "hide": false,
        "legendFormat": "Alpenglow observed inclusion readiness",
        "range": false,
        "refId": "A",
        "instant": true
      }
    ],
    "title": "Alpenglow observed inclusion readiness",
    "transparent": true,
    "type": "stat",
    "maxDataPoints": 1
  },
  {
    "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
    },
    "description": "Finalized context slot of the vote-account snapshot used for the latest observed/inferred interval.",
    "fieldConfig": {
      "defaults": {
        "color": {
          "mode": "thresholds"
        },
        "decimals": 2,
        "mappings": [],
        "noValue": "No recent data",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            {
              "color": "green",
              "value": null
            }
          ]
        },
        "unit": "none"
      },
      "overrides": []
    },
    "gridPos": {
      "h": 3,
      "w": 6,
      "x": 18,
      "y": 55
    },
    "id": 172,
    "interval": "1m",
    "options": {
      "colorMode": "value",
      "graphMode": "none",
      "justifyMode": "auto",
      "orientation": "horizontal",
      "reduceOptions": {
        "calcs": [
          "lastNotNull"
        ],
        "fields": "",
        "values": false
      },
      "textMode": "auto"
    },
    "pluginVersion": "9.2.3",
    "targets": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "editorMode": "code",
        "expr": "last_over_time(nodemonitor_alpenglowObservedSlot{cluster=~\"$cluster\",genesis=~\"$genesis\",consensus=\"alpenglow\",pubkey=\"$pubkey\",vote_account=~\"$vote_account\"}[5m])",
        "hide": false,
        "legendFormat": "Alpenglow observed snapshot slot",
        "range": false,
        "refId": "A",
        "instant": true
      }
    ],
    "title": "Alpenglow observed snapshot slot",
    "transparent": true,
    "type": "stat",
    "maxDataPoints": 1
  },
  {
    "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
    },
    "description": "Observed/inferred reward-accounting inclusion per collector interval. The denominator is estimated from bounded current reference validators. This is not certificate-direct Votor telemetry.",
    "fieldConfig": {
      "defaults": {
        "color": {
          "mode": "palette-classic"
        },
        "custom": {
          "drawStyle": "bars",
          "fillOpacity": 25,
          "lineWidth": 1,
          "spanNulls": false
        },
        "decimals": 0,
        "mappings": [],
        "min": 0,
        "noValue": "Unattributed / collecting",
        "unit": "none"
      },
      "overrides": []
    },
    "gridPos": {
      "h": 8,
      "w": 24,
      "x": 0,
      "y": 58
    },
    "id": 171,
    "interval": "30s",
    "maxDataPoints": 1200,
    "options": {
      "legend": {
        "calcs": [
          "lastNotNull",
          "max"
        ],
        "displayMode": "table",
        "placement": "right",
        "showLegend": true
      },
      "tooltip": {
        "mode": "multi",
        "sort": "desc"
      }
    },
    "targets": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "editorMode": "code",
        "expr": "nodemonitor_alpenglowObservedIncluded{cluster=~\"$cluster\",genesis=~\"$genesis\",consensus=\"alpenglow\",pubkey=\"$pubkey\",vote_account=~\"$vote_account\"}",
        "hide": false,
        "legendFormat": "Observed included",
        "range": true,
        "refId": "A",
        "instant": false
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "editorMode": "code",
        "expr": "nodemonitor_alpenglowObservedExpected{cluster=~\"$cluster\",genesis=~\"$genesis\",consensus=\"alpenglow\",pubkey=\"$pubkey\",vote_account=~\"$vote_account\"}",
        "hide": false,
        "legendFormat": "Estimated opportunities",
        "range": true,
        "refId": "B",
        "instant": false
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "editorMode": "code",
        "expr": "nodemonitor_alpenglowObservedMissed{cluster=~\"$cluster\",genesis=~\"$genesis\",consensus=\"alpenglow\",pubkey=\"$pubkey\",vote_account=~\"$vote_account\"}",
        "hide": false,
        "legendFormat": "Observed shortfall",
        "range": true,
        "refId": "C",
        "instant": false
      }
    ],
    "title": "Alpenglow observed inclusion — inferred interval counts",
    "transparent": true,
    "type": "timeseries"
  }
]
